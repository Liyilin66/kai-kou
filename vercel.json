{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [{ "path": "/api/health", "schedule": "0 3 * * *" }],
  "rewrites": [
    { "source": "/api/questions/(.*)", "destination": "/api/questions?type=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
